# Copy to .env.local to override locally.
# Where the /sling/* proxy forwards API calls (server-side, so no CORS needed).
SLING_API_URL=http://127.0.0.1:8000/users/book

# Leave unset so the browser uses the /sling proxy. Only set this if the API
# sends CORS headers for the storefront's origin.
# NEXT_PUBLIC_API_BASE_URL=https://test.slingbillings.com/users/book
